    local INVIS_ANIMATION_ID = "rbxassetid://136370737633649"
    local INVIS_TIME_POSITION = 4.56
    local INVIS_SPEED = 0
    local INVIS_BODY = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
    local invisTrack = nil
    local invisSaved = {}
    local invisRespawn = nil

    local function fadeBody(character)
        if not character then return end
        for _, name in ipairs(INVIS_BODY) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") and part.Transparency < 1 then
                if invisSaved[part] == nil then
                    invisSaved[part] = part.Transparency
                end
                part.Transparency = 0.5
            end
        end
    end

    local function unfadeBody()
        for part, original in pairs(invisSaved) do
            if part.Parent and part.Transparency == 0.5 then
                part.Transparency = original
            end
        end
        table.clear(invisSaved)
    end

    local function playInvis(character)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 3))
        if not animator then return end
        if invisTrack and invisTrack.IsPlaying then return end

        local animation = Instance.new("Animation")
        animation.AnimationId = INVIS_ANIMATION_ID
        local ok, loaded = pcall(function()
            return animator:LoadAnimation(animation)
        end)
        if not ok or not loaded then return end
        invisTrack = loaded
        loaded:Play()
        loaded.TimePosition = INVIS_TIME_POSITION
        loaded:AdjustSpeed(INVIS_SPEED)
    end

    local function stopInvis()
        if invisTrack then
            pcall(function() invisTrack:Stop() end)
            invisTrack = nil
        end
    end

    local function applyInvis(character)
        if not character or not luna.invis then return end
        fadeBody(character)
        playInvis(character)
    end

    local function setInvis(on)
        on = on and true or false
        if luna.invis == on then return end
        luna.invis = on
        if on then
            task.spawn(applyInvis, LocalPlayer.Character)
            -- Reaplica após morrer / renascer
            invisRespawn = LocalPlayer.CharacterAdded:Connect(function(character)
                stopInvis()
                table.clear(invisSaved)
                if not luna.invis then return end
                character:WaitForChild("Humanoid", 10)
                task.wait(0.6)
                if character.Parent then
                    applyInvis(character)
                end
            end)
        else
            if invisRespawn then
                invisRespawn:Disconnect()
                invisRespawn = nil
            end
            stopInvis()
            unfadeBody()
        end
        lunaRefresh("luna_invis")
    end

