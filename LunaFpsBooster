                Size = size,
                BackgroundColor3 = C.row,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = text,
                TextSize = textSize or 16,
                TextColor3 = C.cyan,
            }, modeRow)
            addCorner(button, 8)
            local stroke = addStroke(button, C.cyan, 1.5, 0.4)
            track(button.MouseEnter:Connect(function()
                tween(stroke, 0.15, {Transparency = 0})
            end))
            track(button.MouseLeave:Connect(function()
                tween(stroke, 0.15, {Transparency = 0.4})
            end))
            return button
        end

        local prevButton = modeButton("◂", 0, UDim2.fromOffset(0, 0), UDim2.fromOffset(36, 36))
        local listButton = modeButton("ALL MODES", 1, UDim2.new(1, 0, 0, 0), UDim2.fromOffset(110, 36), 10)
        local nextButton = modeButton("▸", 1, UDim2.new(1, -118, 0, 0), UDim2.fromOffset(36, 36))
        setDyn(listButton, "ALL MODES")

        cuUI.modeLabel = create("TextLabel", {
            Position = UDim2.fromOffset(42, 0),
            Size = UDim2.new(1, -202, 1, 0),
            BackgroundColor3 = C.row,
            BackgroundTransparency = 0.05,
            Font = Enum.Font.GothamBold,
            Text = "--",
            TextSize = 11,
            TextColor3 = C.text,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, modeRow)
        addCorner(cuUI.modeLabel, 8)
        addStroke(cuUI.modeLabel, C.stroke, 1, 0.2)

        local modeItems = {}
        for i, mode in ipairs(rgbModes) do
            modeItems[i] = {id = i, text = mode.name, color = mode.fn(i * 0.37, (i * 0.0617) % 1)}
        end
        modeGrid = createChoiceGrid(page, 3, modeItems, function(index)
            custom.source = "mode"
            custom.modeIndex = index
            applySource()
            refreshSelections()
        end, 28, 9)
        modeGrid.holder.Visible = false

        local function stepMode(direction)
            local index
            if custom.source == "mode" then
                index = (custom.modeIndex - 1 + direction) % #rgbModes + 1
            else
                index = direction > 0 and 1 or #rgbModes
            end
            custom.source = "mode"
            custom.modeIndex = index
            applySource()
            refreshSelections()
        end
        track(prevButton.Activated:Connect(function() stepMode(-1) end))
        track(nextButton.Activated:Connect(function() stepMode(1) end))
        track(listButton.Activated:Connect(function()
            local show = not modeGrid.holder.Visible
            modeGrid.holder.Visible = show
            setDyn(listButton, show and "HIDE MODES" or "ALL MODES")
        end))

        createSection(page, "MOVING LIGHT")
        createToggle(page, "cu_light", "Moving Light", "A shine band sweeps across the window",
            function() return custom.light end, setLight)
        lightGrid = createChoiceGrid(page, 3, {
            {id = "white", text = "White", color = Color3.new(1, 1, 1)},
            {id = "ice", text = "Ice Blue", color = RGB(105, 220, 255)},
            {id = "pink", text = "Pink", color = RGB(255, 145, 220)},
        }, function(id)
            custom.lightStyle = id
            applyLightColor()
            refreshSelections()
        end)

        createSection(page, "EFFECTS")
        createToggle(page, "cu_glow", "Neon Glow", "Pulsing glow behind the window",
            function() return custom.glow end, setGlow, C.pink)
        createToggle(page, "cu_decor", "Theme Decorations", "Bats, bubbles or stars floating in the window",
            function() return custom.decor end, setDecor, C.pink)

        createButton(page, "RESTORE DEFAULT UI", C.cyan, restoreDefaultUI)

        refreshSelections()
        langHooks[#langHooks + 1] = refreshModeLabel
    end
end
setupCustomModule()

-- ════════════════════════════════════════════════════════════════
-- OTHERS SCRIPTS — executa scripts externos (loadstring + HttpGet)
-- Só roda quando o usuário clica em EXECUTE SCRIPT. Precisa de um
-- executor com suporte a loadstring e game:HttpGet; no Roblox Studio /
-- jogo normal essas funções não existem e a aba avisa o erro.
-- ════════════════════════════════════════════════════════════════
local function runRemoteScript(entry, setBusy)
    if entry.busy then return end
    entry.busy = true
    setBusy(true)
    task.spawn(function()
        local function finish()
            entry.busy = false
            if alive then setBusy(false) end
        end

        local okGet, source = pcall(function()
            return game:HttpGet(entry.url, true)
        end)
        if not okGet then
            notify("This executor does not support loadstring / HttpGet", C.red)
            finish()
            return
        end
        if type(source) ~= "string" or source == "" then
            notify("Could not download: %s", C.red, entry.name)
            finish()
            return
        end

        local okLoad, compiled = pcall(function()
            return loadstring(source)
        end)
        if not okLoad or type(compiled) ~= "function" then
            notify("This executor does not support loadstring / HttpGet", C.red)
            finish()
            return
        end

        notify("Script executed: %s", C.green, entry.name)
        finish()
        -- O script roda em thread própria (pode ter loops/yields); erros posteriores são avisados
        task.spawn(function()
            local okRun = pcall(compiled)
            if not okRun then
                notify("Script failed: %s", C.red, entry.name)
            end
        end)
    end)
end

local function createScriptRow(page, entry)
    local row = create("Frame", {
        Name = "script_" .. entry.id,
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = C.row,
        BackgroundTransparency = 0.05,
        LayoutOrder = nextOrder(page),
    }, page)
    addCorner(row, 10)
