    local function candyActive(token)
        return luna.candy and candy.token == token and alive
    end

    local function getCandyPosition(candyItem)
        local restAttribute = candyItem:GetAttribute("Rest")
        if typeof(restAttribute) == "Vector3" then
            return restAttribute
        elseif typeof(restAttribute) == "CFrame" then
            return restAttribute.Position
        end

        local restObject = candyItem:FindFirstChild("Rest")
        if restObject then
            if restObject:IsA("ObjectValue") and restObject.Value and restObject.Value:IsA("BasePart") then
                return restObject.Value.Position
            elseif restObject:IsA("BasePart") then
                return restObject.Position
            elseif restObject:IsA("Vector3Value") then
                return restObject.Value
            end
        end
        return nil
    end

    local function findClosestCandy(root, folder)
        local closestPosition, closestDistance
        for _, candyItem in ipairs(folder:GetChildren()) do
            local position = getCandyPosition(candyItem)
            if position then
                local distance = (root.Position - position).Magnitude
                if not closestDistance or distance < closestDistance then
                    closestDistance = distance
                    closestPosition = position
                end
            end
        end
        return closestPosition
    end

    local function findClosestCandyDoor(root, trees)
        local bestPrompt, bestPart, bestDistance
        for _, tree in ipairs(trees:GetChildren()) do
            local door = tree:FindFirstChild("DOOR 1 NEW")
            local frame = door and door:FindFirstChild("Frame")
            local prompt = frame and frame:FindFirstChild("TrickOrTreat")
            local part = prompt and prompt.Parent
            if prompt and prompt:IsA("ProximityPrompt") and part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude
                if not bestDistance or distance < bestDistance then
                    bestPrompt, bestPart, bestDistance = prompt, part, distance
                end
            end
        end
        return bestPrompt, bestPart
    end

    local function activateCandyDoor(prompt, part, root, token)
        if not prompt or not part or not root then
            return false
        end

        -- Espera um pouco o prompt da porta ficar disponível
        local waitStarted = os.clock()
        while candyActive(token) and prompt.Parent and not prompt.Enabled and os.clock() - waitStarted < 3 do
            task.wait(0.1)
        end

        if not candyActive(token) or not prompt.Parent or not part.Parent or not prompt.Enabled then
            return false
        end

        -- Fica dentro do alcance do prompt, de frente para a porta
        local approachDistance = math.clamp(prompt.MaxActivationDistance - 1, 2, 5)
        local approachPosition = part.Position + part.CFrame.LookVector * approachDistance + Vector3.new(0, 0.5, 0)
        root.CFrame = CFrame.lookAt(approachPosition, part.Position)
        task.wait(0.25)

        if not candyActive(token) or not prompt.Parent or not prompt.Enabled then
            return false
        end

        local distance = (root.Position - part.Position).Magnitude
        if distance > prompt.MaxActivationDistance then
            return false
        end

        -- Usa fireproximityprompt quando existir; senão, os métodos de input do ProximityPrompt
        if type(fireproximityprompt) == "function" then
            local ok = pcall(function()
                fireproximityprompt(prompt)
            end)
            return ok
        end

        local ok = pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration, 0.1) + 0.15)
            prompt:InputHoldEnd()
        end)
        return ok
    end

    local setCandy

    local function runAutoCandy(token)
        local candyFolder = Workspace:WaitForChild("HalloweenCandy", 10)
        local doorTrees = Workspace:WaitForChild("HalloweenDoorTrees", 10)
        if not candyActive(token) then return end
        if not candyFolder or not doorTrees then
            setCandy(false)
            setCandyStatus("STATUS: REQUIRED FOLDERS NOT FOUND")
            return
        end

        while candyActive(token) do
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if not humanoid or not root or humanoid.Health <= 0 then
                setCandyStatus("STATUS: WAITING FOR CHARACTER")
                task.wait(0.5)
                continue
            end

            if character:FindFirstChild("RootAnchor") or character:FindFirstChild("NoRotate") then
                setCandyStatus("STATUS: WAITING FOR DOOR")
                task.wait(0.25)
                continue
            end

            local candyPosition = findClosestCandy(root, candyFolder)
            if candyPosition then
                setCandyStatus("STATUS: COLLECTING CANDY")
                root.CFrame = CFrame.new(candyPosition + Vector3.new(0, 4, 0))
                humanoid.Jump = true
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            else
                local prompt, part = findClosestCandyDoor(root, doorTrees)
                if prompt and part then
                    setCandyStatus("STATUS: OPENING NEAREST DOOR")
                    local opened = activateCandyDoor(prompt, part, root, token)
                    if not candyActive(token) then return end
                    if opened then
                        setCandyStatus("STATUS: DOOR INTERACTION COMPLETE")
                    else
                        setCandyStatus("STATUS: DOOR NOT READY - RETRYING")
                    end
                    task.wait(0.5)
                else
                    setCandyStatus("STATUS: NO CANDY OR DOORS FOUND")
                    task.wait(0.5)
                end
            end
            task.wait(0.15)
        end
    end

    setCandy = function(on)
        on = on and true or false
        if luna.candy == on then return end
        luna.candy = on
        candy.token += 1 -- invalida qualquer loop anterior (garante um único loop ativo)
        if on then
            setCandyStatus("STATUS: STARTING...")
            candyDrawingCreate()
            task.spawn(runAutoCandy, candy.token)
        else
            setCandyStatus("STATUS: OFF")
            candyDrawingRemove()
        end
        lunaRefresh("luna_candy")
    end

    -- ════════════════ HEADLESS & KORBLOX (cosmético local) ════════════════
    local KORBLOX_MESH, KORBLOX_TEX = "101851696", "101851254"
    local HEAD_MESH, HEAD_TEX = "134082579", "134082627"
    local cosmeticState = setmetatable({}, {__mode = "k"})
    local cosmeticConns = {}

    local function getCosmeticState(character)
        local cState = cosmeticState[character]
        if not cState then
            cState = {headChildren = {}, accessories = {}}
            cosmeticState[character] = cState
        end
        return cState
    end

    local function applyHeadless(character)
        local head = character and character:FindFirstChild("Head")
        if not head then return end
        local cState = getCosmeticState(character)

        if not cState.headProps then
            cState.headProps = {
                Transparency = head.Transparency,
                BrickColor = head.BrickColor,
                Material = head.Material,
            }
        end

        for _, child in ipairs(head:GetChildren()) do
            if (child:IsA("Decal") or child:IsA("SpecialMesh")) and child.Name ~= "LunaHeadlessMesh" then
                table.insert(cState.headChildren, child)
                child.Parent = nil
            end
        end

        local mesh = head:FindFirstChild("LunaHeadlessMesh")
        if not mesh then
            mesh = Instance.new("SpecialMesh")
            mesh.Name = "LunaHeadlessMesh"
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://" .. HEAD_MESH
            mesh.TextureId = "rbxassetid://" .. HEAD_TEX
            mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
            mesh.Offset = Vector3.new(0, 0, 0)
            mesh.Parent = head
        end
        head.Transparency = 0.1
        head.BrickColor = BrickColor.new("Really black")
        head.Material = Enum.Material.Plastic

        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Accessory") then
                local handle = item:FindFirstChild("Handle")
                local attachment = handle and handle:FindFirstChildOfClass("Attachment")
                if attachment then
                    local n = attachment.Name:lower()
                    if n:find("hair") or n:find("hat") or n:find("face") then
                        table.insert(cState.accessories, item)
                        item.Parent = nil
                    end
                end
            end
        end
    end

    local function restoreHeadless(character)
        local cState = cosmeticState[character]
        if not cState then return end
        local head = character:FindFirstChild("Head")
        if head then
            local mesh = head:FindFirstChild("LunaHeadlessMesh")
            if mesh then mesh:Destroy() end
            if cState.headProps then
                head.Transparency = cState.headProps.Transparency
                head.BrickColor = cState.headProps.BrickColor
                head.Material = cState.headProps.Material
            end
            for _, child in ipairs(cState.headChildren) do
                child.Parent = head
            end
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        for _, accessory in ipairs(cState.accessories) do
            if not accessory.Parent then
                local ok = humanoid and pcall(function() humanoid:AddAccessory(accessory) end)
                if not ok then accessory.Parent = character end
            end
        end
        table.clear(cState.headChildren)
        table.clear(cState.accessories)
        cState.headProps = nil
    end

    local function applyKorblox(character)
        local leg = character and (character:FindFirstChild("Right Leg") or character:FindFirstChild("RightLowerLeg"))
        if not leg then return end
        local cState = getCosmeticState(character)
        if cState.legTransparency == nil then
            cState.legTransparency = leg.Transparency
        end

        if character:FindFirstChild("FakeKorbloxLeg") then
            leg.Transparency = 1
            return
        end

        local fake = Instance.new("Part")
        fake.Name = "FakeKorbloxLeg"
        fake.Size = leg.Size
        fake.CFrame = leg.CFrame
        fake.Anchored = false
        fake.CanCollide = false
        fake.Massless = true
        fake.Transparency = 0
        fake.BrickColor = BrickColor.new("Really black")
        fake.Material = Enum.Material.Plastic

        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. KORBLOX_MESH
        mesh.TextureId = "rbxassetid://" .. KORBLOX_TEX
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Offset = Vector3.new(0, 0, 0)
        mesh.Parent = fake
        fake.Parent = character

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = leg
        weld.Part1 = fake
        weld.Parent = fake

        leg.Transparency = 1
        fake.CFrame = leg.CFrame
    end

    local function restoreKorblox(character)
        local fake = character:FindFirstChild("FakeKorbloxLeg")
        if fake then fake:Destroy() end
        local leg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightLowerLeg")
        local cState = cosmeticState[character]
        if leg and cState and cState.legTransparency ~= nil then
            leg.Transparency = cState.legTransparency
        end
        if cState then cState.legTransparency = nil end
    end

    local function applyCosmetics(character)
        if not character or not character.Parent then return end
        if luna.headless then pcall(applyHeadless, character) end
        if luna.korblox then pcall(applyKorblox, character) end
    end

