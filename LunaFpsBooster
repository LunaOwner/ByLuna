-- ATUALIZAÇÕES DE INTERFACE (HUD, status, monitor)
-- ════════════════════════════════════════════════════════════════
updateHUD = function()
    if not ui.hud then return end
    local show = hudReady and (config.showFps or config.showPing)
    ui.hud.Visible = show and true or false
    ui.hudFps.Visible = config.showFps
    ui.hudPing.Visible = config.showPing
    if monitor.fps > 0 then
        ui.hudFps.Text = string.format("FPS %d", round(monitor.fps))
        ui.hudFps.TextColor3 = fpsColor(monitor.fps)
        ui.hudPing.Text = string.format("PING %d ms", round(monitor.ping))
    end
end

updateStatus = function()
    local active = countBits(band(activeMask, ALL_EFFECTS_MASK))
    local stateKey
    if scanning or draining then
        stateKey = "Applying..."
    elseif active > 0 then
        stateKey = "Optimized"
    else
        stateKey = "Idle"
    end
    local stateText = tr(stateKey)
    if ui.boosterInfo then
        ui.boosterInfo.Text = string.format(tr("Active optimizations: %d / %d     State: %s"), active, #EFFECT_ORDER, stateText)
    end
    if monUI.system then
        monUI.system.Text = string.format("%s (%d)", stateText, active)
    end
    if ui.advInfo and ui.currentTab == "advanced" then
        local quality = "?"
        local rendering = getRendering()
        if rendering then
            local ok, name = pcall(function() return rendering.QualityLevel.Name end)
            if ok then quality = name end
        end
        ui.advInfo.Text = string.format(tr("Auto stage: %d/%d     Dynamic boost: %s     Quality: %s"),
            auto.stage, #AUTO_STAGES, dyn.active and tr("ACTIVE") or tr("standby"), quality)
    end
end

updateMonitorUI = function()
    if not monUI.fps then return end
    local fps = monitor.fps
    local color = fpsColor(fps)
    monUI.fps.Text = tostring(round(fps))
    monUI.fps.TextColor3 = color
    monUI.ping.Text = string.format("%d ms", round(monitor.ping))
    monUI.frame.Text = string.format("%.1f ms", monitor.frameMs)
    monUI.memory.Text = string.format("%d MB", round(monitor.memory))
    monUI.perf.Text = tr(fpsLabel(fps))
    monUI.perf.TextColor3 = color
    monUI.perfDot.BackgroundColor3 = color
    monUI.max.Text = monitor.maxFps and tostring(round(monitor.maxFps)) or "--"
    monUI.min.Text = monitor.minFps and tostring(round(monitor.minFps)) or "--"
    monUI.max.TextColor3 = C.green
    monUI.min.TextColor3 = C.red
end

updateGraph = function()
    local bars = monUI.bars
    if not bars then return end
    local history = monitor.history
    local n = #history
    local peak = 60
    for i = 1, n do
        if history[i] > peak then peak = history[i] end
    end
    monUI.peak.Text = tostring(round(peak))
    for i = 1, HISTORY_SIZE do
        local bar = bars[i]
        local value = history[i - (HISTORY_SIZE - n)]
        if value then
            bar.Visible = true
            bar.Size = UDim2.new(1 / HISTORY_SIZE, -1, math.clamp(value / peak, 0.02, 1), 0)
            bar.BackgroundColor3 = fpsColor(value)
        else
            bar.Visible = false
        end
    end
end

-- Notificação (toast). "text" é a chave em inglês; argumentos extras formatam a tradução.
notify = function(text, color, ...)
    if not ui.toast or not ui.window.Visible then return end
    ui.toastToken += 1
    local token = ui.toastToken
    local toast = ui.toast
    local message = tr(text)
    if select("#", ...) > 0 then
        message = string.format(message, ...)
    end
    ui.toastLabel.Text = message
    ui.toastStroke.Color = color or C.cyan
    toast.Position = UDim2.new(0.5, 0, 1, 40)
    toast.Visible = true
    tween(toast, 0.3, {Position = UDim2.new(0.5, 0, 1, -14)}, Enum.EasingStyle.Back)
    task.delay(2.8, function()
        if not alive or token ~= ui.toastToken then return end
        local t = tween(toast, 0.25, {Position = UDim2.new(0.5, 0, 1, 50)})
        t.Completed:Connect(function()
            if token == ui.toastToken then toast.Visible = false end
        end)
    end)
end

refreshPositionText = function()
    if ui.positionButton then
        ui.positionButton.Text = string.format(tr("Interface Position: %s"), tr(POSITION_NAMES[config.position]))
    end
end

