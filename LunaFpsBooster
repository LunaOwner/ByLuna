local function round(n)
    return math.floor(n + 0.5)
end

local function create(className, props, parent)
    local inst = Instance.new(className)
    for property, value in pairs(props) do
        inst[property] = value
    end
    if parent then inst.Parent = parent end
    return inst
end

local function tween(inst, duration, props, style, direction)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function addCorner(inst, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius)}, inst)
end

local function addCircle(inst)
    return create("UICorner", {CornerRadius = UDim.new(1, 0)}, inst)
end

local function addStroke(inst, color, thickness, transparency)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function addRGBGradient(parent, phase)
    local gradient = create("UIGradient", {Color = currentSequence, Rotation = phase or 0}, parent)
    rgbGradients[#rgbGradients + 1] = {gradient = gradient, phase = phase or 0}
    return gradient
end

local function updateRGB()
    local angle = (os.clock() * 60) % 360
    local i = 1
    while i <= #rgbGradients do
        local entry = rgbGradients[i]
        if entry.gradient.Parent then
            entry.gradient.Rotation = (angle + entry.phase) % 360
            i += 1
        else
            table.remove(rgbGradients, i)
        end
    end
end

local function resetRGBRotation()
    for _, entry in ipairs(rgbGradients) do
        if entry.gradient.Parent then
            entry.gradient.Rotation = entry.phase
        end
    end
end

local function nextOrder(page)
    pageOrder[page] = (pageOrder[page] or 0) + 1
    return pageOrder[page]
end

local function fpsColor(fps)
    if fps >= 55 then return C.green end
    if fps >= 40 then return C.cyan end
    if fps >= 25 then return C.yellow end
    return C.red
end

local function fpsLabel(fps)
    if fps >= 55 then return "EXCELLENT" end
    if fps >= 40 then return "GOOD" end
    if fps >= 25 then return "AVERAGE" end
    return "CRITICAL"
end

-- ════════════════════════════════════════════════════════════════
-- MOTOR DE OTIMIZAÇÃO — sistema de "claims" (alterações restauráveis)
-- Cada propriedade alterada guarda o valor original + máscara de donos.
-- Quando o último dono libera, o valor original é restaurado.
-- ════════════════════════════════════════════════════════════════
local claims = setmetatable({}, {__mode = "k"}) -- instância -> {prop -> {orig, mask}}
local activeMask = 0
local smartHeld = false
local requestCount = {}
local scanning = false
local draining = false
local scanPending = 0

local function getProperty(inst, prop) return inst[prop] end
local function setProperty(inst, prop, value) inst[prop] = value end

local function claimProp(inst, prop, value, bit, force)
    local per = claims[inst]
    local entry = per and per[prop]
    if entry then
        if band(entry.mask, bit) ~= 0 and not force then return end
        entry.mask = bor(entry.mask, bit)
        pcall(setProperty, inst, prop, value)
        return
    end
    local ok, original = pcall(getProperty, inst, prop)
    if not ok or original == value then return end
    if not per then
        per = {}
        claims[inst] = per
    end
    per[prop] = {orig = original, mask = bit}
    pcall(setProperty, inst, prop, value)
end

local function heldMask()
    return bor(activeMask, smartHeld and B.Smart or 0)
end

-- Libera (restaura) todas as propriedades pertencentes aos bits informados.
-- Executa em lotes por frame; aborta para bits que foram reativados.
local function releaseBits(mask, onDone)
    task.spawn(function()
        local keys = {}
        for inst in pairs(claims) do keys[#keys + 1] = inst end
        local start = os.clock()
        for i = 1, #keys do
            local inst = keys[i]
            local per = claims[inst]
            if per then
                local releasable = band(mask, bnot(heldMask()))
                if releasable ~= 0 then
                    for prop, entry in pairs(per) do
                        if band(entry.mask, releasable) ~= 0 then
                            entry.mask = band(entry.mask, bnot(releasable))
                            if entry.mask == 0 then
                                pcall(setProperty, inst, prop, entry.orig)
                                per[prop] = nil
                            end
                        end
                    end
                    if next(per) == nil then claims[inst] = nil end
                end
            end
            if os.clock() - start > SCAN_BUDGET then
                task.wait()
                start = os.clock()
            end
        end
        if onDone then onDone() end
    end)
end

-- ── Classificação por nome (palavras inteiras, com cache) ─────────
local WORDS = {}
local function registerWords(bit, list)
    for _, word in ipairs(list) do
        WORDS[word] = bor(WORDS[word] or 0, bit)
    end
end
registerWords(B.Trees, {"tree", "pine", "palm", "oak", "birch", "spruce", "maple", "willow", "cedar",
    "foliage", "leaf", "leaves", "forest", "trunk", "cactus", "bamboo"})
registerWords(B.Mountains, {"mountain", "hill", "cliff", "volcano", "boulder", "rock", "peak", "crag"})
registerWords(B.Grass, {"grass", "grasses", "flower", "weed", "bush", "shrub", "fern", "vegetation",
    "hedge", "reed", "clover", "mushroom", "sprout", "moss"})
registerWords(B.Decorations, {"decor", "decoration", "deco", "ornament", "statue", "vase", "painting",
    "banner", "flag", "balloon", "garland", "wreath", "trophy"})

local nameMaskCache = {}
local function getNameMask(name)
    local cached = nameMaskCache[name]
    if cached then return cached end
    local mask = 0
    local spaced = string.lower((string.gsub(name, "(%l)(%u)", "%1 %2")))
    for token in string.gmatch(spaced, "%a+") do
        local direct = WORDS[token]
        if direct then mask = bor(mask, direct) end
        if string.sub(token, -1) == "s" then
            local singular = WORDS[string.sub(token, 1, -2)]
            if singular then mask = bor(mask, singular) end
        end
    end
    nameMaskCache[name] = mask
    return mask
end

-- ── Informações de classe (cache por ClassName) ───────────────────
local PARTICLE_CLASSES = {ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true}
local POSTFX_CLASSES = {BloomEffect = true, BlurEffect = true, DepthOfFieldEffect = true, SunRaysEffect = true}
local BLOCKERS = {
    ProximityPrompt = true, ClickDetector = true, Humanoid = true,
    Seat = true, VehicleSeat = true, SpawnLocation = true,
}

local classInfoCache = {}
local function getClassInfo(inst)
    local className = inst.ClassName
    local info = classInfoCache[className]
    if info then return info end
    local isPart = inst:IsA("BasePart") and not inst:IsA("Terrain")
    info = {
        part = isPart,
        container = isPart or inst:IsA("Model") or inst:IsA("Folder"),
        face = inst:IsA("FaceInstance"),
        emitter = PARTICLE_CLASSES[className] == true,
        light = inst:IsA("Light"),
        postfx = POSTFX_CLASSES[className] == true,
        mesh = className == "MeshPart" or inst:IsA("PartOperation"),
        meshPart = className == "MeshPart",
    }
    info.needsProtection = info.part or info.face or info.emitter or info.light
    info.interesting = info.container or info.face or info.emitter or info.light or info.postfx
    classInfoCache[className] = info
    return info
end

-- ── Proteção: personagens, veículos, assentos, spawns, câmera ─────
local protCache = setmetatable({}, {__mode = "k"})
local function isProtectedInstance(inst)
    local current = inst
    while current and current ~= Workspace do
        local className = current.ClassName
        if className == "Camera" or className == "Tool" or className == "Seat"
            or className == "VehicleSeat" or className == "SpawnLocation" then
            return true
        end
        if current:IsA("Model") then
            local cached = protCache[current]
            if cached == nil then
                cached = current:FindFirstChildOfClass("Humanoid") ~= nil
                    or current:FindFirstChildOfClass("VehicleSeat") ~= nil
                protCache[current] = cached
            end
            if cached then return true end
        end
        current = current.Parent
    end
    return false
end

-- ── Raízes correspondidas por nome (árvores, grama, etc.) ─────────
local matchedRoots = {}
local function resetRoots(bit)
    matchedRoots[bit] = setmetatable({}, {__mode = "k"})
end
for _, name in ipairs(EFFECT_ORDER) do resetRoots(B[name]) end

local function hideClaim(part, bit)
    claimProp(part, "LocalTransparencyModifier", 1, bit)
end

local function simplifyClaim(part, bit)
    claimProp(part, "Material", Enum.Material.SmoothPlastic, bit)
    claimProp(part, "Reflectance", 0, bit)
    claimProp(part, "CastShadow", false, bit)
    if part:IsA("MeshPart") or part:IsA("PartOperation") then
        claimProp(part, "RenderFidelity", Enum.RenderFidelity.Performance, bit)
    end
end

local function applyByName(inst, info, bit, nameMask, claimer, checkBlockers)
    if not info.container then return end
    local roots = matchedRoots[bit]
    if next(roots) ~= nil then
        local current = inst
        while current and current ~= Workspace do
            if roots[current] then
                if info.part then claimer(inst, bit) end
                return
            end
            current = current.Parent
        end
    end
    if band(nameMask, bit) == 0 then return end
    if isProtectedInstance(inst) then return end
    local descendants = inst:GetDescendants()
    if checkBlockers then
        if BLOCKERS[inst.ClassName] then return end
        for i = 1, #descendants do
            if BLOCKERS[descendants[i].ClassName] then return end
        end
    end
    roots[inst] = true
    if info.part then claimer(inst, bit) end
    for i = 1, #descendants do
        local d = descendants[i]
        if getClassInfo(d).part then claimer(d, bit) end
    end
end

local function applyAll(inst, mask)
    if not inst.Parent then return end
    local info = getClassInfo(inst)
    if not info.interesting then return end
    if info.needsProtection and isProtectedInstance(inst) then return end

    local nameMask = 0
    if info.container and band(mask, NAME_BITS) ~= 0 then
        nameMask = getNameMask(inst.Name)
    end

    if band(mask, B.Trees) ~= 0 then applyByName(inst, info, B.Trees, nameMask, hideClaim, true) end
    if band(mask, B.Grass) ~= 0 then applyByName(inst, info, B.Grass, nameMask, hideClaim, true) end
    if band(mask, B.Decorations) ~= 0 then applyByName(inst, info, B.Decorations, nameMask, hideClaim, true) end
    if band(mask, B.Mountains) ~= 0 then applyByName(inst, info, B.Mountains, nameMask, simplifyClaim, false) end

    if band(mask, B.Textures) ~= 0 then
        if info.face then
            claimProp(inst, "Transparency", 1, B.Textures)
        elseif info.part then
            claimProp(inst, "Material", Enum.Material.SmoothPlastic, B.Textures)
            claimProp(inst, "Reflectance", 0, B.Textures)
            if info.meshPart then claimProp(inst, "TextureID", "", B.Textures) end
        end
    end

    if band(mask, B.Particles) ~= 0 and info.emitter then
        claimProp(inst, "Enabled", false, B.Particles)
    end

    if band(mask, B.Shadows) ~= 0 then
        if info.part then
            claimProp(inst, "CastShadow", false, B.Shadows)
        elseif info.light then
            claimProp(inst, "Shadows", false, B.Shadows)
        end
    end

    if band(mask, B.VisualFX) ~= 0 and info.postfx then
        claimProp(inst, "Enabled", false, B.VisualFX)
    end

    if band(mask, B.Meshes) ~= 0 and info.mesh then
        claimProp(inst, "RenderFidelity", Enum.RenderFidelity.Performance, B.Meshes)
    end
end

-- ── Fila de objetos adicionados depois (processada em lotes) ──────
local queue, qHead, qTail = {}, 1, 0

local function drainQueue()
    if draining then return end
    draining = true
    task.spawn(function()
        local start = os.clock()
        while qHead <= qTail and activeMask ~= 0 and alive do
            local inst = queue[qHead]
            queue[qHead] = nil
            qHead += 1
            if inst then pcall(applyAll, inst, activeMask) end
            if os.clock() - start > SCAN_BUDGET then
                task.wait()
                start = os.clock()
            end
        end
        if activeMask == 0 then table.clear(queue) end
        if qHead > qTail then
            qHead, qTail = 1, 0
        end
        draining = false
        table.clear(protCache)
        if updateStatus then updateStatus() end
    end)
end

local function onDescendantAdded(inst)
    if activeMask == 0 then return end
    qTail += 1
    queue[qTail] = inst
    drainQueue()
end

local watchConns = {}
local function ensureWatchers()
    if #watchConns > 0 then return end
    watchConns[1] = Workspace.DescendantAdded:Connect(onDescendantAdded)
    watchConns[2] = Lighting.DescendantAdded:Connect(onDescendantAdded)
end

local function dropWatchers()
    for i = #watchConns, 1, -1 do
        watchConns[i]:Disconnect()
        watchConns[i] = nil
    end
    table.clear(queue)
    qHead, qTail = 1, 0
end

-- ── Varredura inicial (uma única GetDescendants para vários efeitos) ──
local function requestScan(mask)
    scanPending = bor(scanPending, mask)
    if scanning then return end
    scanning = true
    if updateStatus then updateStatus() end
    task.spawn(function()
        while scanPending ~= 0 and alive do
            local mask2 = scanPending
            scanPending = 0
            local list = Workspace:GetDescendants()
            if band(mask2, B.VisualFX) ~= 0 then
                for _, d in ipairs(Lighting:GetDescendants()) do list[#list + 1] = d end
            end
            local start = os.clock()
            for i = 1, #list do
                local m = band(mask2, activeMask)
                if m == 0 then break end
                pcall(applyAll, list[i], m)
                if os.clock() - start > SCAN_BUDGET then
                    task.wait()
                    start = os.clock()
                end
            end
        end
        scanning = false
        table.clear(protCache)
        if updateStatus then updateStatus() end
    end)
end

-- ── Ajustes globais (Lighting, Terrain, Rendering) ────────────────
local renderingCache
local function getRendering()
    if renderingCache then return renderingCache end
    local ok, rendering = pcall(function() return settings().Rendering end)
    if ok then renderingCache = rendering end
    return renderingCache
end

local function getTerrain()
    return Workspace:FindFirstChildOfClass("Terrain")
end

local effectEngage = {
    Grass = function()
        local terrain = getTerrain()
        if terrain then claimProp(terrain, "Decoration", false, B.Grass) end
    end,
    Shadows = function()
        claimProp(Lighting, "GlobalShadows", false, B.Shadows)
    end,
    LowGraphics = function()
        local rendering = getRendering()
        if rendering then
            claimProp(rendering, "QualityLevel", Enum.QualityLevel.Level01, B.LowGraphics, true)
        end
        local terrain = getTerrain()
        if terrain then
            claimProp(terrain, "WaterWaveSize", 0, B.LowGraphics)
            claimProp(terrain, "WaterWaveSpeed", 0, B.LowGraphics)
            claimProp(terrain, "WaterReflectance", 0, B.LowGraphics)
        end
    end,
}

local SCANNED_EFFECTS = {
    Trees = true, Mountains = true, Grass = true, Decorations = true, Textures = true,
    Particles = true, Shadows = true, VisualFX = true, Meshes = true,
}

local function engageEffect(name)
    local bit = B[name]
    activeMask = bor(activeMask, bit)
    ensureWatchers()
    local engage = effectEngage[name]
    if engage then pcall(engage) end
    if SCANNED_EFFECTS[name] then requestScan(bit) end
    if updateStatus then updateStatus() end
end

local function disengageEffect(name)
    local bit = B[name]
    activeMask = band(activeMask, bnot(bit))
    resetRoots(bit)
    releaseBits(bit)
    if activeMask == 0 then dropWatchers() end
    if updateStatus then updateStatus() end
end

local function requestEffect(name)
    local n = (requestCount[name] or 0) + 1
    requestCount[name] = n
    if n == 1 then engageEffect(name) end
end

local function releaseEffect(name)
    local n = requestCount[name] or 0
    if n <= 0 then return end
    n -= 1
    requestCount[name] = n
    if n == 0 then disengageEffect(name) end
end

local function countBits(mask)
    local count = 0
    for _, name in ipairs(EFFECT_ORDER) do
        if band(mask, B[name]) ~= 0 then count += 1 end
    end
    return count
end

-- ════════════════════════════════════════════════════════════════
-- AUTOMAÇÃO: Automatic Optimization, Dynamic Performance, Smart Graphics
-- ════════════════════════════════════════════════════════════════
local AUTO_STAGES = {
    {"Particles", "Shadows", "VisualFX"},
    {"Textures", "LowGraphics", "Meshes", "Decorations"},
    {"Trees", "Grass", "Mountains"},
}
local DYN_EFFECTS = {"Particles", "Shadows", "VisualFX"}

local auto = {stage = 0, low = 0, cooldown = 0, owned = {}}
local dyn = {active = false, low = 0, high = 0, cooldown = 0, owned = {}}
local smart = {level = nil, base = 8, low = 0, high = 0, claimed = false, lowWasActive = false}
local memoryTimer = 0

local function ownedRequest(owner, name)
    if not owner[name] then
        owner[name] = true
        requestEffect(name)
    end
end

local function ownedReleaseAll(owner)
    for name in pairs(owner) do
        owner[name] = nil
        releaseEffect(name)
    end
end

local function autoStart()
    auto.stage, auto.low, auto.cooldown = 0, 0, 0
end

local function autoStop()
    ownedReleaseAll(auto.owned)
    auto.stage, auto.low, auto.cooldown = 0, 0, 0
end

local function autoStep(fps)
    if auto.cooldown > 0 then
        auto.cooldown -= 1
        return
    end
    if fps < 25 then auto.low += 1 else auto.low = 0 end
    if auto.low >= 6 and auto.stage < #AUTO_STAGES then
        auto.stage += 1
        auto.low = 0
        auto.cooldown = 10
        for _, name in ipairs(AUTO_STAGES[auto.stage]) do ownedRequest(auto.owned, name) end
        if notify then notify("Auto Optimization: stage %d/%d", C.yellow, auto.stage, #AUTO_STAGES) end
    end
end

local function dynStart()
    dyn.active, dyn.low, dyn.high, dyn.cooldown = false, 0, 0, 0
end

local function dynStop()
    ownedReleaseAll(dyn.owned)
    dyn.active, dyn.low, dyn.high, dyn.cooldown = false, 0, 0, 0
end

local function dynamicStep(fps)
    if dyn.cooldown > 0 then
        dyn.cooldown -= 1
        return
    end
    if not dyn.active then
        if fps < 35 then dyn.low += 1 else dyn.low = 0 end
        if dyn.low >= 4 then
            dyn.active, dyn.low, dyn.high, dyn.cooldown = true, 0, 0, 6
            for _, name in ipairs(DYN_EFFECTS) do ownedRequest(dyn.owned, name) end
            if notify then notify("Dynamic Performance: boost engaged", C.yellow) end
        end
    else
        if fps >= 55 then dyn.high += 1 else dyn.high = 0 end
        if dyn.high >= 16 then
            dyn.active, dyn.low, dyn.high, dyn.cooldown = false, 0, 0, 6
            ownedReleaseAll(dyn.owned)
            if notify then notify("Dynamic Performance: boost released", C.green) end
        end
    end
end

local function enumForLevel(level)
    local ok, item = pcall(function()
        return Enum.QualityLevel[string.format("Level%02d", level)]
    end)
    if ok then return item end
    return nil
end

local function applySmartLevel()
    local rendering = getRendering()
    local item = enumForLevel(smart.level)
    if rendering and item then
        claimProp(rendering, "QualityLevel", item, B.Smart, true)
        smart.claimed = true
    end
end

local function smartStart()
    smartHeld = true
    smart.level, smart.low, smart.high, smart.claimed, smart.lowWasActive = nil, 0, 0, false, false
end

local function smartStop()
    smartHeld = false
    smart.level, smart.claimed = nil, false
    releaseBits(B.Smart)
end

local function smartStep(fps)
    local rendering = getRendering()
    if not rendering then return end
    if (requestCount.LowGraphics or 0) > 0 then
        smart.lowWasActive = true
        smart.low, smart.high = 0, 0
        return
    end
    if smart.lowWasActive then
        smart.lowWasActive = false
        if smart.claimed and smart.level then applySmartLevel() end
    end
    if smart.level == nil then
        local ok, current = pcall(getProperty, rendering, "QualityLevel")
        local value = (ok and current and current.Value) or 0
        smart.base = (value == 0) and 8 or math.clamp(value, 1, 10)
        smart.level = smart.base
    end
    if fps < 40 then
        smart.low += 1
        smart.high = 0
    elseif fps >= 58 then
        smart.high += 1
        smart.low = 0
    else
        smart.low, smart.high = 0, 0
    end
    if smart.low >= 6 and smart.level > 1 then
        smart.level -= 1
        smart.low = 0
        applySmartLevel()
    elseif smart.high >= 20 and smart.level < smart.base then
        smart.level += 1
        smart.high = 0
        applySmartLevel()
    end
end

local function flushCaches()
    table.clear(protCache)
    table.clear(nameMaskCache)
end

