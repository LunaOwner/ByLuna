        Text = description,
        TextSize = 11,
        TextColor3 = C.sub,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local statusText = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -44, 0.5, 0),
        Size = UDim2.fromOffset(36, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "OFF",
        TextSize = 12,
        TextColor3 = C.red,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local indicator = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -24, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = C.red,
    }, row)
    addCircle(indicator)
    local indicatorStroke = addStroke(indicator, C.red, 2, 0.55)

    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, row)

    track(button.MouseEnter:Connect(function()
        tween(rowStroke, 0.15, {Color = hoverColor})
        tween(row, 0.15, {BackgroundColor3 = C.rowHover})
    end))
    track(button.MouseLeave:Connect(function()
        tween(rowStroke, 0.15, {Color = C.stroke})
        tween(row, 0.15, {BackgroundColor3 = C.row})
    end))
    track(button.Activated:Connect(function()
        setter(not getter())
    end))

    toggleVisuals[id] = function(instant)
        local on = getter() and true or false
        local color = on and C.green or C.red
        statusText.Text = on and "ON" or "OFF"
        if instant then
            indicator.BackgroundColor3 = color
            indicatorStroke.Color = color
            statusText.TextColor3 = color
        else
            tween(indicator, 0.25, {BackgroundColor3 = color})
            tween(indicatorStroke, 0.25, {Color = color})
            tween(statusText, 0.25, {TextColor3 = color})
            indicator.Size = UDim2.fromOffset(24, 24)
            tween(indicator, 0.25, {Size = UDim2.fromOffset(18, 18)}, Enum.EasingStyle.Back)
        end
    end
    toggleVisuals[id](true)
end

refreshToggle = function(id, instant)
    local visual = toggleVisuals[id]
    if visual then visual(instant) end
end

