-- LUNA COMMUNITY — RECURSOS (somente cliente)
-- Dash cooldown, Anti-AFK, Speed (Heartbeat), Auto Candy, Headless,
-- Korblox, ESP Ultimate, Check Ult e Invisibility.
-- Tudo começa DESATIVADO; cada toggle executa a função de verdade
-- e desconecta suas conexões ao ser desligado.
-- Mobile: o Speed usa um botão RUN na tela (segurar) no lugar da tecla F.
-- ════════════════════════════════════════════════════════════════
local function setupLunaModule()
    local okVirtualUser, VirtualUser = pcall(function()
        return game:GetService("VirtualUser")
    end)

    local RGB = Color3.fromRGB
    local CYAN, PURPLE, PINK, GOLD = RGB(0, 220, 255), RGB(190, 70, 255), RGB(255, 70, 200), RGB(255, 205, 70)
    local ULT_MAX = 100 -- valor em que a ULT é considerada cheia (ajuste se o seu jogo usar outro máximo)

    local luna = {
        noDash = false, antiAfk = false, candy = false, speed = false,
        headless = false, korblox = false, espUlt = false, checkUlt = false, invis = false,
    }
    local lunaUI = {}

    local function lunaRefresh(id)
        if refreshToggle then refreshToggle(id) end
    end

    local function getHumanoid()
        local character = LocalPlayer.Character
        return character and character:FindFirstChildOfClass("Humanoid")
    end

    local function lunaOutline(obj, color, thickness)
        return addStroke(obj, color, thickness, 0.12)
    end

    local function lunaGradientText(label)
        return create("UIGradient", {Color = RGB_SEQUENCE}, label)
    end

    -- ════════════════ NO DASH COOLDOWN ════════════════
    local DASH_ATTRIBUTES = {"VIPServer", "VIPServerOwner", "NoDashCooldown"}
    local dashBackup = nil

    local function setNoDash(on)
        on = on and true or false
        if luna.noDash == on then return end
        luna.noDash = on
        if on then
            dashBackup = {}
            for _, name in ipairs(DASH_ATTRIBUTES) do
                dashBackup[name] = Workspace:GetAttribute(name)
            end
            Workspace:SetAttribute("VIPServer", tostring(LocalPlayer.UserId))
            Workspace:SetAttribute("VIPServerOwner", LocalPlayer.Name)
            Workspace:SetAttribute("NoDashCooldown", true)
        else
            if dashBackup then
                for _, name in ipairs(DASH_ATTRIBUTES) do
                    Workspace:SetAttribute(name, dashBackup[name])
                end
                dashBackup = nil
            end
            Workspace:SetAttribute("NoDashCooldown", false)
        end
        lunaRefresh("luna_dash")
    end

    -- ════════════════ ANTI-AFK ════════════════
    local afkConnection = nil

    local function setAntiAfk(on)
        on = on and true or false
        if luna.antiAfk == on then return end
        luna.antiAfk = on
        -- Flag para sistemas de AFK dentro do seu próprio jogo
        LocalPlayer:SetAttribute("LunaAntiAFKEnabled", on)
        if afkConnection then
            afkConnection:Disconnect()
            afkConnection = nil
        end
        if on and okVirtualUser then
            -- Evita o kick de inatividade da plataforma simulando um clique quando o Idled dispara
            afkConnection = LocalPlayer.Idled:Connect(function()
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end)
            end)
        end
        lunaRefresh("luna_afk")
    end

    -- ════════════════ SPEED BY HEARTBEAT ════════════════
    local speed = {
        multiplier = 1.8, min = 1.1, max = 5.0, step = 0.1,
        held = false, original = nil, humanoid = nil,
        tracks = {}, conns = {}, animConn = nil,
    }

    local function updateSpeedStatus()
        -- Botão RUN (mobile): visível somente com o Speed ligado em dispositivos touch
        if lunaUI.runButton then
            lunaUI.runButton.Visible = (luna.speed and IS_TOUCH) and true or false
        end
        if not lunaUI.speedStatus then return end
        local key
        if not luna.speed then
            key = IS_TOUCH and "STATUS: OFF  •  HOLD RUN BUTTON" or "STATUS: OFF  •  HOLD F TO RUN"
        elseif speed.held then
            key = IS_TOUCH and "STATUS: RUNNING  •  RELEASE BUTTON" or "STATUS: RUNNING  •  RELEASE F TO STOP"
        else
            key = IS_TOUCH and "STATUS: ON  •  HOLD RUN BUTTON" or "STATUS: ON  •  HOLD F TO RUN"
        end
        setDyn(lunaUI.speedStatus, key)
    end

    local function updateSpeedValue()
        if lunaUI.speedValue then
            lunaUI.speedValue.Text = string.format("%.1fx", speed.multiplier)
        end
    end

    local function restoreSpeed()
        local humanoid = speed.humanoid or getHumanoid()
        if humanoid and humanoid.Parent and speed.original then
            humanoid.WalkSpeed = speed.original
        end
        speed.original = nil
    end

    -- Segurar / soltar o modo corrida (tecla F no PC, botão RUN no mobile)
    local function setHeld(value)
        if not luna.speed then return end
        speed.held = value and true or false
        if not speed.held then restoreSpeed() end
        updateSpeedStatus()
    end

    -- Mantém a animação de andar/correr em 1x enquanto a velocidade real muda
    local function keepLocomotionNormal(animTrack)
        local trackName = string.lower(animTrack.Name or "")
        if trackName:find("walk", 1, true) or trackName:find("run", 1, true) then
            speed.tracks[animTrack] = true
            animTrack:AdjustSpeed(1)
        end
    end

    local function bindSpeedCharacter(character)
        if speed.animConn then
            speed.animConn:Disconnect()
            speed.animConn = nil
        end
        speed.original = nil
        speed.held = false
        table.clear(speed.tracks)
        updateSpeedStatus()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not humanoid or not luna.speed then return end
        speed.humanoid = humanoid
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
        if animator and luna.speed then
            for _, animTrack in ipairs(animator:GetPlayingAnimationTracks()) do
                keepLocomotionNormal(animTrack)
            end
            speed.animConn = animator.AnimationPlayed:Connect(keepLocomotionNormal)
        end
    end

    local function speedStep()
        local humanoid = getHumanoid()
        if not humanoid or humanoid.Health <= 0 then return end
        speed.humanoid = humanoid
        if speed.held then
            if not speed.original then
                speed.original = humanoid.WalkSpeed
            end
            humanoid.WalkSpeed = speed.original * speed.multiplier
        elseif speed.original then
            restoreSpeed()
        end
        for animTrack in pairs(speed.tracks) do
            if animTrack.IsPlaying then
                animTrack:AdjustSpeed(1)
            else
                speed.tracks[animTrack] = nil
            end
        end
    end

    local function setSpeed(on)
        on = on and true or false
        if luna.speed == on then return end
        luna.speed = on
        if on then
            local character = LocalPlayer.Character
            if character then task.spawn(bindSpeedCharacter, character) end
            speed.conns[#speed.conns + 1] = LocalPlayer.CharacterAdded:Connect(bindSpeedCharacter)
            speed.conns[#speed.conns + 1] = UserInputService.InputBegan:Connect(function(input, processed)
                if processed or UserInputService:GetFocusedTextBox() then return end
                if input.KeyCode == Enum.KeyCode.F then
                    setHeld(true)
                end
            end)
            speed.conns[#speed.conns + 1] = UserInputService.InputEnded:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.F then
                    setHeld(false)
                end
            end)
            speed.conns[#speed.conns + 1] = RunService.Heartbeat:Connect(speedStep)
        else
            for i = #speed.conns, 1, -1 do
                speed.conns[i]:Disconnect()
                speed.conns[i] = nil
            end
            if speed.animConn then
                speed.animConn:Disconnect()
                speed.animConn = nil
            end
            speed.held = false
            restoreSpeed()
            table.clear(speed.tracks)
        end
        lunaRefresh("luna_speed")
        updateSpeedStatus()
    end

    local function changeSpeedMultiplier(direction)
        local value = speed.multiplier + direction * speed.step
