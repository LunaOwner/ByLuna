    -- Pulsos / especiais (11)
    addPulse("NEON PINK", RGB(255, 40, 170), 2.2)
    addPulse("NEON CYAN", RGB(0, 240, 255), 2.2)
    addPulse("NEON GREEN", RGB(40, 255, 110), 2.2)
    addPulse("NEON PURPLE", RGB(170, 70, 255), 2.2)
    addPulse("NEON BLUE", RGB(50, 110, 255), 2.2)
    addPulse("NEON ORANGE", RGB(255, 130, 20), 2.2)
    addPulse("NEON RED", RGB(255, 35, 50), 2.2)
    addPulse("NEON YELLOW", RGB(255, 235, 40), 2.2)
    addMode("HEARTBEAT", function(t)
        local p = (t * 1.1) % 1
        local k = exp(-((p - 0.1) * 16) ^ 2) + 0.7 * exp(-((p - 0.32) * 16) ^ 2)
        return RGB(90, 0, 15):Lerp(RGB(255, 40, 70), min(k, 1))
    end)
    addMode("THUNDER", function(t)
        local flash = max(0, sin(t * 7) * sin(t * 3.1) - 0.55) * 2.2
        return RGB(60, 80, 230):Lerp(RGB(255, 255, 255), min(flash, 1))
    end)
    addMode("BREATHE", function(t)
        return RGB(120, 120, 150):Lerp(RGB(255, 255, 255), 0.5 + 0.5 * sin(t * 1.6))
    end)

    -- ── Fonte de cor dos gradientes RGB ───────────────────────────
    local function setGradientSequence(seq)
        currentSequence = seq
        for _, entry in ipairs(rgbGradients) do
            if entry.gradient.Parent then
                entry.gradient.Color = seq
            end
        end
    end

    local function modeSequence()
        local fn = rgbModes[custom.modeIndex].fn
        local now = os.clock()
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, fn(now, custHue)),
            ColorSequenceKeypoint.new(0.25, fn(now + 0.4, (custHue + 0.08) % 1)),
            ColorSequenceKeypoint.new(0.5, fn(now + 0.8, (custHue + 0.16) % 1)),
            ColorSequenceKeypoint.new(0.75, fn(now + 1.2, (custHue + 0.24) % 1)),
            ColorSequenceKeypoint.new(1, fn(now + 1.6, (custHue + 0.32) % 1)),
        })
    end

    local function applySource()
        local seq
        if custom.source == "mode" then
            seq = modeSequence()
        elseif custom.source == "preset" then
            seq = PRESET_SEQ[custom.preset]
        else
            seq = RGB_SEQUENCE
        end
        setGradientSequence(seq)
    end

    -- Cor representativa atual (brilho neon)
    local function accentColor()
        if custom.source == "mode" then
            return rgbModes[custom.modeIndex].fn(os.clock(), custHue)
        elseif custom.source == "preset" then
            return PRESETS[custom.preset][1]
        end
        return C.cyan:Lerp(C.purple, 0.5 + 0.5 * sin(os.clock() * 1.5))
    end

    local function refreshModeLabel()
        local label = cuUI.modeLabel
        if not label then return end
        if custom.source == "mode" then
            dynTexts[label] = nil
            label.Text = string.format("%02d/%d  %s", custom.modeIndex, #rgbModes, rgbModes[custom.modeIndex].name)
        else
            setDyn(label, "DEFAULT NEON")
        end
    end

    local function refreshSelections()
        if themeGrid then themeGrid.setSelected(custom.theme) end
        if neonGrid then
            local id = nil
            if custom.source == "default" then
                id = "default"
            elseif custom.source == "preset" then
                id = custom.preset
            end
            neonGrid.setSelected(id)
        end
        if modeGrid then modeGrid.setSelected(custom.source == "mode" and custom.modeIndex or nil) end
        if lightGrid then lightGrid.setSelected(custom.lightStyle) end
        refreshModeLabel()
    end

    -- ── Decorações (emojis do tema, bolhas, estrelas) ─────────────
    local decorParts = {}

    local function clearDecor()
        if ui.decor then ui.decor:ClearAllChildren() end
        table.clear(decorParts)
    end

    local function buildDecor()
        clearDecor()
        if not custom.decor or not ui.decor then return end
        local theme = THEMES[custom.theme]
        if theme.kind == "emoji" then
            local fall = theme.motion == "fall"
            for i = 1, theme.count or 14 do
                local glyph = theme.set[(i - 1) % #theme.set + 1]
                local bat = glyph == "🦇"
                local label = create("TextLabel", {
                    BackgroundTransparency = 1, Text = glyph,
                    TextSize = rnd:NextInteger(14, 26),
                    TextColor3 = theme.color or Color3.new(1, 1, 1),
                    Font = theme.color and Enum.Font.Code or Enum.Font.Gotham,
                    Size = UDim2.fromOffset(30, 30),
                    TextTransparency = 0.35, ZIndex = 0,
                }, ui.decor)
                local rate = rnd:NextNumber(0.02, 0.05)
                decorParts[#decorParts + 1] = {
                    o = label, kind = bat and "bat" or "float",
                    x = rnd:NextNumber(0, 1), y = rnd:NextNumber(0, 1),
                    vx = bat and rnd:NextNumber(0.04, 0.1) * (i % 2 == 0 and 1 or -1) or rnd:NextNumber(-0.015, 0.015),
                    vy = bat and 0 or (fall and rate or -rate),
                    ph = rnd:NextNumber(0, 6.28),
                }
            end
            if theme.corner then
                create("TextLabel", {
                    BackgroundTransparency = 1, Text = theme.corner, TextSize = 44,
                    Size = UDim2.fromOffset(50, 50), Position = UDim2.new(0, 4, 1, -54),
                    TextTransparency = 0.6, ZIndex = 0,
                }, ui.decor)
                create("TextLabel", {
                    BackgroundTransparency = 1, Text = theme.corner, TextSize = 44,
                    Size = UDim2.fromOffset(50, 50), Position = UDim2.new(1, -54, 1, -54),
                    TextTransparency = 0.6, ZIndex = 0,
                }, ui.decor)
            end
        elseif theme.kind == "bubble" then
            for _ = 1, 16 do
                local size = rnd:NextInteger(6, 18)
                local bubble = create("Frame", {
                    Size = UDim2.fromOffset(size, size),
                    BackgroundColor3 = RGB(120, 230, 255),
                    BackgroundTransparency = 0.85, BorderSizePixel = 0, ZIndex = 0,
                }, ui.decor)
                addCircle(bubble)
                create("UIStroke", {Color = RGB(170, 240, 255), Thickness = 1, Transparency = 0.45}, bubble)
                decorParts[#decorParts + 1] = {
                    o = bubble, kind = "bubble",
                    x = rnd:NextNumber(0, 1), y = rnd:NextNumber(0, 1),
                    vx = 0, vy = -rnd:NextNumber(0.03, 0.08), ph = rnd:NextNumber(0, 6.28),
                }
            end
        else
            for i = 1, 16 do
                local label = create("TextLabel", {
                    BackgroundTransparency = 1, Text = "✦",
                    TextSize = rnd:NextInteger(8, 15),
                    TextColor3 = (i % 2 == 0) and RGB(90, 225, 255) or RGB(185, 120, 255),
                    Size = UDim2.fromOffset(20, 20), ZIndex = 0,
                }, ui.decor)
                decorParts[#decorParts + 1] = {
                    o = label, kind = "star",
                    x = rnd:NextNumber(0, 1), y = rnd:NextNumber(0, 1),
                    vx = rnd:NextNumber(-0.01, 0.01), vy = -rnd:NextNumber(0.01, 0.025),
                    ph = rnd:NextNumber(0, 6.28),
                }
            end
        end
    end

    local function updateDecor(step, t)
        for _, q in ipairs(decorParts) do
            q.x += q.vx * step
            q.y += q.vy * step
            if q.x > 1.05 then q.x = -0.05 elseif q.x < -0.05 then q.x = 1.05 end
            if q.y < -0.08 then q.y = 1.08 elseif q.y > 1.08 then q.y = -0.08 end
            local offX, offY = 0, 0
            if q.kind == "bat" then
                offY = sin(t * 3 + q.ph) * 14
            elseif q.kind == "bubble" or q.kind == "float" then
                offX = sin(t + q.ph) * 6
            elseif q.kind == "star" then
                q.o.TextTransparency = 0.45 + 0.4 * sin(t * 2 + q.ph)
            end
            q.o.Position = UDim2.new(q.x, offX, q.y, offY)
        end
    end

    local function setDecor(on)
        custom.decor = on and true or false
        buildDecor()
        refreshToggle("cu_decor")
    end

    -- ── Luz em movimento ──────────────────────────────────────────
    local LIGHT_COLORS = {
        white = Color3.new(1, 1, 1),
        ice = RGB(105, 220, 255),
        pink = RGB(255, 145, 220),
    }

    local function applyLightColor()
        if ui.light then ui.light.BackgroundColor3 = LIGHT_COLORS[custom.lightStyle] or LIGHT_COLORS.white end
    end

    local function setLight(on)
        custom.light = on and true or false
        if ui.lightTween then
            ui.lightTween:Cancel()
            ui.lightTween = nil
        end
        if ui.light then
            if custom.light then
                applyLightColor()
                ui.light.Position = UDim2.new(0, -120, -0.3, 0)
                ui.light.Visible = true
                ui.lightTween = TweenService:Create(
                    ui.light,
                    TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1),
                    {Position = UDim2.new(1, 120, -0.3, 0)}
                )
                ui.lightTween:Play()
            else
                ui.light.Visible = false
            end
        end
        refreshToggle("cu_light")
    end

    -- ── Brilho neon atrás da janela ───────────────────────────────
    local function setGlow(on)
        custom.glow = on and true or false
        if ui.glowTween then
            ui.glowTween:Cancel()
            ui.glowTween = nil
        end
        if ui.glow then
            if custom.glow then
                ui.glow.ImageColor3 = accentColor()
                ui.glow.ImageTransparency = 0.35
                ui.glow.Visible = true
                ui.glowTween = TweenService:Create(
                    ui.glow,
                    TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                    {ImageTransparency = 0.62}
                )
                ui.glowTween:Play()
            else
                ui.glow.Visible = false
            end
        end
        refreshToggle("cu_glow")
