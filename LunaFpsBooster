    -- ── Tema ──────────────────────────────────────────────────────
    local function setTheme(name)
        local theme = THEMES[name]
        if not theme then return end
        custom.theme = name
        applyPalette(name)
        if theme.preset then
            custom.source, custom.preset = "preset", theme.preset
        else
            custom.source = "default"
        end
        applySource()
        setDecor(name ~= "original")
        for _, refresh in ipairs(choiceRefreshers) do refresh() end
        refreshSelections()
    end

    local function restoreDefaultUI()
        custom.lightStyle = "white"
        setLight(false)
        setGlow(false)
        custom.modeIndex = 1
        setTheme("original")
        notify("UI restored to default", C.cyan)
    end

    -- Chamado pelo Heartbeat principal (~30 Hz, só com a janela visível e animações RGB ligadas)
    customTick = function(step)
        custHue = (custHue + step * 0.13) % 1
        if not ui.window.Visible then return end
        if custom.source == "mode" then
            setGradientSequence(modeSequence())
        end
        if custom.glow and ui.glow then
            ui.glow.ImageColor3 = accentColor()
        end
        if custom.decor then
            updateDecor(step, os.clock())
        end
    end

    -- ── Grade de botões de escolha ────────────────────────────────
    local function createChoiceGrid(page, columns, items, onPick, height, textSize)
        local holder = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = nextOrder(page),
        }, page)
        local pad = 8
        create("UIGridLayout", {
            CellSize = UDim2.new(1 / columns, -math.ceil(pad * (columns - 1) / columns), 0, height or 34),
            CellPadding = UDim2.fromOffset(pad, pad),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, holder)

        local grid = {holder = holder}
        local entries = {}
        local selected = nil

        local function paint(entry, isSelected, hovered)
            local bg = C.row
            if isSelected then
                bg = C.row:Lerp(entry.color, 0.28)
            elseif hovered then
                bg = C.row:Lerp(entry.color, 0.14)
            end
            tween(entry.button, 0.15, {BackgroundColor3 = bg})
            tween(entry.stroke, 0.15, {Transparency = isSelected and 0 or 0.45})
            entry.stroke.Thickness = isSelected and 2 or 1.5
        end

        grid.setSelected = function(id)
            selected = id
            for _, entry in ipairs(entries) do
                paint(entry, id ~= nil and entry.id == id, false)
            end
        end

        for index, item in ipairs(items) do
            local button = create("TextButton", {
                LayoutOrder = index,
                BackgroundColor3 = C.row,
                AutoButtonColor = false,
                Font = Enum.Font.GothamBold,
                Text = item.text,
                TextSize = textSize or 11,
                TextColor3 = item.color,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, holder)
            addCorner(button, 8)
            local stroke = addStroke(button, item.color, 1.5, 0.45)
            local entry = {id = item.id, button = button, stroke = stroke, color = item.color}
            entries[#entries + 1] = entry
            track(button.MouseEnter:Connect(function()
                if selected ~= entry.id then paint(entry, false, true) end
            end))
            track(button.MouseLeave:Connect(function()
                if selected ~= entry.id then paint(entry, false, false) end
            end))
            track(button.Activated:Connect(function()
                onPick(item.id)
            end))
        end

        choiceRefreshers[#choiceRefreshers + 1] = function()
            grid.setSelected(selected)
        end
        return grid
    end

    -- ── Página Custom UI ──────────────────────────────────────────
    buildCustomPage = function(page)
        createSection(page, "THEME")
        local themeItems = {}
        for _, id in ipairs(THEME_ORDER) do
            themeItems[#themeItems + 1] = {id = id, text = THEMES[id].name, color = THEMES[id].accent}
        end
        themeGrid = createChoiceGrid(page, 3, themeItems, function(id)
            setTheme(id)
        end)

        createSection(page, "NEON COLOR")
        local neonItems = {{id = "default", text = "Default RGB", color = C.cyan}}
        for _, id in ipairs(PRESET_ORDER) do
            neonItems[#neonItems + 1] = {id = id, text = PRESET_NAMES[id], color = PRESETS[id][1]}
        end
        neonGrid = createChoiceGrid(page, 3, neonItems, function(id)
            if id == "default" then
                custom.source = "default"
