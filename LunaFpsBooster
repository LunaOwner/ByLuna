-- INICIALIZAÇÃO
-- ════════════════════════════════════════════════════════════════
buildInterface()
buildConfirmation()
applyLanguage()

local rgbAccumulator = 0
track(RunService.Heartbeat:Connect(function(dt)
    -- Monitor: apenas contadores por frame; processamento a cada 0.5s
    monitor.frames += 1
    monitor.elapsed += dt
    if dt > monitor.worstDt then monitor.worstDt = dt end
    if monitor.elapsed >= SAMPLE_INTERVAL then
        pushSample()
    end

    -- Animação RGB (30 Hz, somente quando há interface visível)
    if config.rgb then
        rgbAccumulator += dt
        if rgbAccumulator >= 0.033 then
            local step = rgbAccumulator
            rgbAccumulator = 0
            if ui.window.Visible or ui.bubble.Visible or ui.overlay then
                updateRGB()
                if customTick then customTick(step) end
            end
        end
    end

    -- Memory Optimization: limpeza periódica de caches internos
    if state.memory then
        memoryTimer += dt
        if memoryTimer >= 30 then
            memoryTimer = 0
            flushCaches()
        end
    end
end))
