-- FEATURES (cada toggle da interface)
-- ════════════════════════════════════════════════════════════════
local FEATURES = {
    potato = {effects = {"Textures", "Particles", "Shadows", "Decorations", "VisualFX"}},
    trees = {effects = {"Trees"}},
    mountains = {effects = {"Mountains"}},
    grass = {effects = {"Grass"}},
    decorations = {effects = {"Decorations"}},
    textures = {effects = {"Textures"}},
    particles = {effects = {"Particles"}},
    shadows = {effects = {"Shadows"}},
    lowgfx = {effects = {"LowGraphics", "Meshes"}},
    ultra = {effects = EFFECT_ORDER},
    autoOpt = {start = autoStart, stop = autoStop},
    smart = {start = smartStart, stop = smartStop},
    dynamic = {start = dynStart, stop = dynStop},
    reduceFX = {effects = {"VisualFX", "Particles"}},
    memory = {effects = {"Meshes"}, start = function() memoryTimer = 0 end},
    lunaBoost = {effects = {"Textures", "Particles", "Trees"}}, -- FPS Boost da aba Luna Community
}

local function setFeature(key, on)
    local def = FEATURES[key]
    if not def then return end
    on = on and true or false
    if (state[key] or false) == on then return end
    state[key] = on
    if on then
        if def.effects then
            for _, name in ipairs(def.effects) do requestEffect(name) end
        end
        if def.start then pcall(def.start) end
    else
        if def.stop then pcall(def.stop) end
        if def.effects then
            for _, name in ipairs(def.effects) do releaseEffect(name) end
        end
    end
    if refreshToggle then refreshToggle(key) end
    if updateStatus then updateStatus() end
end

local function disableAllFeatures()
    for key in pairs(FEATURES) do
        if state[key] then pcall(setFeature, key, false) end
    end
end

-- Botão de emergência: desfaz tudo e garante que nada ficou para trás
local function emergencyRestore()
    if lunaDisableAll then pcall(lunaDisableAll) end
    disableAllFeatures()
    ownedReleaseAll(auto.owned)
    ownedReleaseAll(dyn.owned)
    for _, name in ipairs(EFFECT_ORDER) do
        requestCount[name] = 0
        resetRoots(B[name])
    end
    activeMask = 0
    smartHeld = false
    scanPending = 0
    dropWatchers()
    flushCaches()
    releaseBits(ALL_BITS_MASK, function()
        if notify then notify("All changes were reverted", C.green) end
        if updateStatus then updateStatus() end
    end)
    if updateStatus then updateStatus() end
end

-- ════════════════════════════════════════════════════════════════
-- MONITOR DE DESEMPENHO
-- ════════════════════════════════════════════════════════════════
local function readPing()
    local ok, value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(value) == "number" then return value end
    local ok2, value2 = pcall(function() return LocalPlayer:GetNetworkPing() * 1000 end)
    if ok2 and type(value2) == "number" then return value2 end
    return 0
end

local function readMemory()
    local ok, value = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
    if ok and type(value) == "number" then return value end
    return 0
end

local function onFpsSample(fps)
    if monitor.samples <= 4 then return end
    if state.autoOpt then autoStep(fps) end
    if state.dynamic then dynamicStep(fps) end
    if state.smart then smartStep(fps) end
end

local function pushSample()
    local fps = monitor.frames / monitor.elapsed
    monitor.fps = fps
    monitor.frameMs = (monitor.elapsed / monitor.frames) * 1000
    monitor.worstMs = monitor.worstDt * 1000
    monitor.frames, monitor.elapsed, monitor.worstDt = 0, 0, 0
    monitor.samples += 1

    local history = monitor.history
    history[#history + 1] = fps
    if #history > HISTORY_SIZE then table.remove(history, 1) end

    if monitor.samples > 2 then
        if not monitor.maxFps or fps > monitor.maxFps then monitor.maxFps = fps end
        if not monitor.minFps or fps < monitor.minFps then monitor.minFps = fps end
    end

    monitor.ping = readPing()
    monitor.memory = readMemory()

    if updateHUD then updateHUD() end
    if ui.currentTab == "monitor" and ui.window and ui.window.Visible then
        if updateMonitorUI then updateMonitorUI() end
        if updateGraph then updateGraph() end
    end
    if updateStatus then updateStatus() end
    onFpsSample(fps)
end
