    local function applyPalette(name)
        local theme = THEMES[name]
        local new = theme and theme.palette
        local old = currentPalette
        if not new or new == old then return end
        local swaps = {}
        for _, key in ipairs(PALETTE_KEYS) do
            swaps[#swaps + 1] = {old[key], new[key]}
        end
        local function remap(color)
            for i = 1, #swaps do
                if color == swaps[i][1] then return swaps[i][2] end
            end
            return nil
        end
        for _, inst in ipairs(ui.gui:GetDescendants()) do
            if inst:IsA("GuiObject") then
                local mapped = remap(inst.BackgroundColor3)
                if mapped then inst.BackgroundColor3 = mapped end
            elseif inst:IsA("UIStroke") then
                local mapped = remap(inst.Color)
                if mapped then inst.Color = mapped end
            end
        end
