local function clampToScreen(pos)
    local viewport = ui.gui.AbsoluteSize
    local size = ui.window.AbsoluteSize
    local x = math.clamp(pos.X, -size.X + 90, math.max(-size.X + 90, viewport.X - 90))
    local y = math.clamp(pos.Y, 0, math.max(0, viewport.Y - 50))
    return Vector2.new(x, y)
end

local function makeDraggable(handle, target)
    track(handle.InputBegan:Connect(function(input)
        local inputType = input.UserInputType
        if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
            return
        end
        local dragStart = input.Position
        local startPos = target.AbsolutePosition
        local moveConn, endConn
        moveConn = UserInputService.InputChanged:Connect(function(changed)
            if changed.UserInputType == Enum.UserInputType.MouseMovement or changed == input then
                local delta = changed.Position - dragStart
                local pos = clampToScreen(Vector2.new(startPos.X + delta.X, startPos.Y + delta.Y))
                target.Position = UDim2.fromOffset(pos.X, pos.Y)
            end
        end)
        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                moveConn:Disconnect()
                endConn:Disconnect()
            end
        end)
    end))
end

local function createPage(parent, name)
    local page = create("ScrollingFrame", {
        Name = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = IS_TOUCH and 5 or 3,
        ScrollBarImageColor3 = C.cyan,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
    }, parent)
