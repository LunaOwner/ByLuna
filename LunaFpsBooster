-- JANELA: posição, layout responsivo, abas, minimizar
-- ════════════════════════════════════════════════════════════════
local function positionWindow(index, animate)
    local viewport = ui.gui.AbsoluteSize
    local size = ui.window.AbsoluteSize
    local margin = 12
    local x = (viewport.X - size.X) / 2
    local y = (viewport.Y - size.Y) / 2
    if index == 2 then
        x, y = margin, margin + 40
    elseif index == 3 then
        x, y = viewport.X - size.X - margin, margin + 40
    elseif index == 4 then
        x, y = margin, viewport.Y - size.Y - margin
    elseif index == 5 then
        x, y = viewport.X - size.X - margin, viewport.Y - size.Y - margin
    end
    local pos = clampToScreen(Vector2.new(x, y))
    local target = UDim2.fromOffset(pos.X, pos.Y)
    if animate then
        tween(ui.window, 0.4, {Position = target}, Enum.EasingStyle.Quint)
    else
        ui.window.Position = target
    end
end

local function tabIndicatorY(tab)
    local step = ui.tabStep or 46
    local height = math.min(26, step - 8)
    return 10 + (tab.index - 1) * step + (step - 6 - height) / 2
end

-- Ajusta o espaçamento das abas para caberem na barra lateral (8 abas)
local function layoutTabs()
    local compact = ui.window.AbsoluteSize.X < 520
    local sidebarHeight = ui.window.AbsoluteSize.Y - 49
    local available = sidebarHeight - 16 - (compact and 0 or 40)
    local step = math.clamp(math.floor(available / (ui.tabCount or 4)), 28, 46)
    ui.tabStep = step
    for _, tab in pairs(ui.tabs) do
        tab.button.Position = UDim2.new(0, 6, 0, 10 + (tab.index - 1) * step)
        tab.button.Size = UDim2.new(1, -12, 0, step - 6)
    end
    ui.tabIndicator.Size = UDim2.fromOffset(3, math.min(26, step - 8))
    local current = ui.tabs[ui.currentTab]
    if current then
        ui.tabIndicator.Position = UDim2.new(0, 0, 0, tabIndicatorY(current))
    end
end

local function applyLayoutMode()
    local compact = ui.window.AbsoluteSize.X < 520
    local width = compact and 46 or 168
    ui.sidebar.Size = UDim2.new(0, width, 1, -49)
    ui.content.Position = UDim2.new(0, width, 0, 49)
    ui.content.Size = UDim2.new(1, -width, 1, -49)
    ui.footer.Visible = not compact
    for _, tab in pairs(ui.tabs) do
        tab.label.Visible = not compact
    end
    layoutTabs()
end

local function selectTab(id)
    if ui.currentTab == id then return end
    local old = ui.pages[ui.currentTab]
    ui.currentTab = id
    for tabId, tab in pairs(ui.tabs) do
        local selected = tabId == id
        tween(tab.button, 0.2, {BackgroundTransparency = selected and 0.8 or 1})
        tween(tab.label, 0.2, {TextColor3 = selected and C.text or C.sub})
        if selected then
            tween(ui.tabIndicator, 0.3, {Position = UDim2.new(0, 0, 0, tabIndicatorY(tab))}, Enum.EasingStyle.Quint)
        end
    end
    if old then old.Visible = false end
    local page = ui.pages[id]
    page.Position = UDim2.new(0, 0, 0, 14)
    page.Visible = true
    tween(page, 0.28, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quint)
    if id == "monitor" then
        updateMonitorUI()
        updateGraph()
    end
    updateStatus()
end

local function setMinimized(minimized)
    if minimized then
        ui.window.Visible = false
        ui.bubble.Size = UDim2.fromOffset(20, 20)
        ui.bubble.Visible = true
        tween(ui.bubble, 0.3, {Size = UDim2.fromOffset(BUBBLE_SIZE, BUBBLE_SIZE)}, Enum.EasingStyle.Back)
    else
        ui.bubble.Visible = false
        local target = ui.window.Position
        ui.window.Position = target + UDim2.fromOffset(0, 18)
        ui.window.Visible = true
        tween(ui.window, 0.3, {Position = target}, Enum.EasingStyle.Quint)
    end
end

local function restoreDefaultSettings()
    for key, value in pairs(DEFAULT_CONFIG) do config[key] = value end
    for _, id in ipairs({"cfg_showFps", "cfg_showPing", "cfg_rgb"}) do refreshToggle(id) end
    resetRGBRotation()
    refreshPositionText()
    positionWindow(config.position, true)
    updateHUD()
    notify("Default settings restored", C.cyan)
end
