        if luna.espUlt == on then return end
        luna.espUlt = on
        espLoopId += 1
        if on then
            local id = espLoopId
            for _, other in ipairs(Players:GetPlayers()) do
                watchPlayer(other)
            end
            table.insert(espMaster, Players.PlayerAdded:Connect(watchPlayer))
            table.insert(espMaster, Players.PlayerRemoving:Connect(function(other)
                destroyUltEsp(other)
                if charConns[other] then
                    charConns[other]:Disconnect()
                    charConns[other] = nil
                end
            end))
            task.spawn(function()
                while luna.espUlt and espLoopId == id do
                    for _, data in pairs(espData) do
                        refreshInfo(data)
                    end
                    task.wait(1)
                end
            end)
        else
            for _, connection in ipairs(espMaster) do connection:Disconnect() end
            table.clear(espMaster)
            for other, connection in pairs(charConns) do
                connection:Disconnect()
                charConns[other] = nil
            end
            for other in pairs(espData) do
                destroyUltEsp(other)
            end
        end
        lunaRefresh("luna_esp")
    end

