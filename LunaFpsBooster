-- ════════════════════════════════════════════════════════════════
local function shutdown()
    if not alive then return end
    if lunaDisableAll then pcall(lunaDisableAll) end
    disableAllFeatures()
    releaseBits(ALL_BITS_MASK)
    dropWatchers()
    alive = false
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)
    if ui.gui then ui.gui:Destroy() end
end

local function launchMain()
    ui.overlay = nil
    positionWindow(config.position, false)
    ui.window.Visible = true
    local target = ui.window.Position
    ui.window.Position = target + UDim2.fromOffset(0, 24)
    tween(ui.window, 0.4, {Position = target}, Enum.EasingStyle.Quint)
    hudReady = true
    updateHUD()
    selectTab("booster")
    updateStatus()
    notify("FPS Booster Supremo ready", C.green)
end

local function buildConfirmation()
    local overlay = create("Frame", {
        Name = "Overlay",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.45,
        Active = true,
        ZIndex = 10,
    }, ui.gui)
    ui.overlay = overlay

    local modal = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(340, 246),
        BackgroundColor3 = C.bg,
        BackgroundTransparency = 0.03,
    }, overlay)
    addCorner(modal, 16)
    addRGBGradient(addStroke(modal, Color3.new(1, 1, 1), 2, 0), 0)

    local brand = create("TextLabel", {
        Position = UDim2.fromOffset(0, 14),
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBlack,
        Text = "⚡ FPS BOOSTER SUPREMO",
        TextSize = 17,
        TextColor3 = Color3.new(1, 1, 1),
    }, modal)
    addRGBGradient(brand, 0)

    -- Seleção de idioma
    local languageLabel = create("TextLabel", {
        Position = UDim2.fromOffset(20, 42),
        Size = UDim2.new(1, -40, 0, 14),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "LANGUAGE / IDIOMA",
        TextSize = 10,
        TextColor3 = C.sub,
    }, modal)

    local languageRow = create("Frame", {
        Position = UDim2.fromOffset(20, 58),
        Size = UDim2.new(1, -40, 0, 32),
        BackgroundTransparency = 1,
    }, modal)

    local languageButtons = {}
    local function refreshLanguageButtons()
        for code, entry in pairs(languageButtons) do
            local selected = code == lang
            tween(entry.button, 0.2, {BackgroundColor3 = selected and C.row:Lerp(C.cyan, 0.25) or C.row})
            tween(entry.stroke, 0.2, {Transparency = selected and 0 or 0.6})
            entry.button.TextColor3 = selected and C.text or C.sub
        end
    end

    local function languageButton(code, text, xScale)
        local button = create("TextButton", {
            Position = UDim2.new(xScale, xScale == 0 and 0 or 4, 0, 0),
            Size = UDim2.new(0.5, -4, 1, 0),
            BackgroundColor3 = C.row,
            AutoButtonColor = false,
            Font = Enum.Font.GothamBold,
            Text = text,
            TextSize = 12,
            TextColor3 = C.sub,
        }, languageRow)
        addCorner(button, 10)
        local stroke = addStroke(button, C.cyan, 1.5, 0.6)
        languageButtons[code] = {button = button, stroke = stroke}
        track(button.Activated:Connect(function()
            if lang == code then return end
            lang = code
            applyLanguage()
            refreshLanguageButtons()
        end))
    end
    languageButton("pt", "PORTUGUÊS (BR)", 0)
    languageButton("en", "ENGLISH (US)", 0.5)
    refreshLanguageButtons()

    local message = create("TextLabel", {
        Position = UDim2.fromOffset(20, 98),
        Size = UDim2.new(1, -40, 0, 56),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "Do you want to run FPS Booster Supremo?",
        TextSize = 16,
        TextColor3 = C.text,
        TextWrapped = true,
    }, modal)

    -- Botões SIM / NÃO
    local buttons = create("Frame", {
        Position = UDim2.fromOffset(20, 170),
        Size = UDim2.new(1, -40, 0, 46),
        BackgroundTransparency = 1,
    }, modal)

    local function choiceButton(text, color, xScale, callback)
        local button = create("TextButton", {
            Position = UDim2.new(xScale, xScale == 0 and 0 or 5, 0, 0),
            Size = UDim2.new(0.5, -5, 1, 0),
            BackgroundColor3 = C.row,
            AutoButtonColor = false,
            Font = Enum.Font.GothamBlack,
            Text = text,
            TextSize = 15,
            TextColor3 = color,
        }, buttons)
        addCorner(button, 12)
        local stroke = addStroke(button, color, 2, 0.2)
        local hoverBg = C.row:Lerp(color, 0.2)
        track(button.MouseEnter:Connect(function()
            tween(button, 0.15, {BackgroundColor3 = hoverBg})
            tween(stroke, 0.15, {Transparency = 0})
        end))
        track(button.MouseLeave:Connect(function()
            tween(button, 0.15, {BackgroundColor3 = C.row})
            tween(stroke, 0.15, {Transparency = 0.2})
        end))
        track(button.Activated:Connect(callback))
    end

    -- Área de carregamento
    local countdown = create("TextLabel", {
        Position = UDim2.fromOffset(0, 130),
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBlack,
        Text = "",
        TextSize = 24,
        TextColor3 = C.cyan,
        Visible = false,
    }, modal)
    local track2 = create("Frame", {
        Position = UDim2.fromOffset(24, 176),
        Size = UDim2.new(1, -48, 0, 10),
        BackgroundColor3 = C.row,
        Visible = false,
    }, modal)
    addCircle(track2)
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track2)
    addCircle(fill)
    addRGBGradient(fill, 0)

    local function startCountdown(text, seconds, onDone)
        languageLabel.Visible = false
        languageRow.Visible = false
        message.Position = UDim2.fromOffset(20, 62)
        message.Text = tr(text)
        buttons.Visible = false
        countdown.Visible = true
        track2.Visible = true
        fill.Size = UDim2.fromScale(0, 1)
        tween(fill, seconds, {Size = UDim2.fromScale(1, 1)}, Enum.EasingStyle.Linear)
        task.spawn(function()
            for remaining = seconds, 1, -1 do
                if not alive then return end
                countdown.Text = tostring(remaining)
                task.wait(1)
            end
            if not alive then return end
            onDone()
        end)
    end

    choiceButton("YES", C.green, 0, function()
        startCountdown("Perfect! Your FPS Booster will start in 5 seconds.", 5, function()
            local fade = tween(overlay, 0.3, {BackgroundTransparency = 1})
            modal.Visible = false
            fade.Completed:Connect(function() overlay:Destroy() end)
            launchMain()
        end)
    end)
    choiceButton("NO", C.red, 0.5, function()
        startCountdown("Ok! Closing GUI in 3 seconds.", 3, function()
            shutdown()
        end)
    end)
end

