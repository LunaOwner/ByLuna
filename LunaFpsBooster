local function tr(en)
    if lang == "pt" then
        return PT[en] or en
    end
    return en
end

-- Define um texto dinâmico (chave em inglês) que acompanha o idioma escolhido
local function setDyn(label, en)
    dynTexts[label] = en
    label.Text = tr(en)
end

local function applyLanguage()
    if not ui.gui then return end
    for _, inst in ipairs(ui.gui:GetDescendants()) do
        if inst:IsA("TextLabel") or inst:IsA("TextButton") then
            local dynamicKey = dynTexts[inst]
            if dynamicKey then
                inst.Text = tr(dynamicKey)
            elseif not skipLocalize[inst] then
                local original = textOrig[inst]
                if not original and PT[inst.Text] then
                    original = inst.Text
                    textOrig[inst] = original
                end
                if original then inst.Text = tr(original) end
            end
        end
    end
    for _, hook in ipairs(langHooks) do
        pcall(hook)
    end
end

