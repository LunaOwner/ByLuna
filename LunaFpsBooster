        return billboard, pulse
    end

    local function scanCheck()
        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= LocalPlayer then
                local character = target.Character
                local head = character and character:FindFirstChild("Head")
                if head and character:FindFirstChild("Counter") then
                    local data = checkData[target]
                    if not data or not data.gui.Parent then
                        removeCheck(target)
                        local billboard, pulse = buildCheck(target, head)
                        checkData[target] = {gui = billboard, tween = pulse}
                    end
                else
                    removeCheck(target)
                end
            end
        end
        for target in pairs(checkData) do
            if not target.Parent then
                removeCheck(target)
            end
        end
    end

    local function setCheckUlt(on)
        on = on and true or false
        if luna.checkUlt == on then return end
        luna.checkUlt = on
        checkLoopId += 1
        if on then
            local id = checkLoopId
            task.spawn(function()
                while luna.checkUlt and checkLoopId == id do
                    pcall(scanCheck)
                    task.wait(0.5)
                end
            end)
        else
            for target in pairs(checkData) do
                removeCheck(target)
            end
        end
        lunaRefresh("luna_check")
    end

