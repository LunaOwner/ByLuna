        ColorSequenceKeypoint.new(0, RGB(255, 170, 40)),
        ColorSequenceKeypoint.new(1, RGB(255, 240, 120)),
    })

    local function updateUlt(data)
        local value = tonumber(data.player:GetAttribute("Ultimate"))
        local percent = value and math.clamp(value / ULT_MAX, 0, 1) or 0
        local ready = value ~= nil and value >= ULT_MAX
        TweenService:Create(data.fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(percent, 0, 1, 0),
        }):Play()
        data.fillGradient.Color = ready and readyFill or normalFill
        data.stroke.Color = ready and GOLD or CYAN
        data.value.TextColor3 = ready and GOLD or RGB(235, 240, 255)
        if value == nil then
            data.value.Text = tr("ULT: N/A")
        elseif ready then
            data.value.Text = tr("ULT READY")
        else
            data.value.Text = "ULT: " .. tostring(math.floor(value))
        end
    end

